{{ ansible_managed | ansible.builtin.comment }}
flush ruleset

table inet firewall {
    chain inbound {
        type filter hook input priority 0; policy drop;
        include "/etc/nftables/inbound-rules.d/*.conf"
    }
    chain forward {
        type filter hook forward priority 0; policy drop;
        include "/etc/nftables/forward-rules.d/*.conf"
    }
}
